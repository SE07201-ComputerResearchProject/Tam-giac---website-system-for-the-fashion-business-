# Database (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=KhakiEcommerceDB

# Preferred: use a full connection string (Windows Integrated Security)
DB_CONNECTION_STRING=Data Source=localhost;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Auth mode for MSSQL (Sequelize + tedious)
# - sql: use DB_USER/DB_PASSWORD
# - windows: use NTLM (requires DB_DOMAIN + DB_WINDOWS_USER + DB_WINDOWS_PASSWORD)
DB_AUTH_MODE=sql
DB_USER=app_user
DB_PASSWORD=YourStrongPassword123!
DB_DOMAIN=
DB_WINDOWS_USER=
DB_WINDOWS_PASSWORD=

# TLS options (local dev typically trusts certificate)
DB_ENCRYPT=true
DB_TRUST_CERT=true
DB_POOL_MAX=10

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ReCAPTCHA v3
RECAPTCHA_SECRET_KEY=your-recaptcha-secret
RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# VNPay (sandbox)
VNPAY_TMN_CODE=your-tmncode
VNPAY_SECRET=your-hashsecret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server
PORT=3000
NODE_ENV=development
