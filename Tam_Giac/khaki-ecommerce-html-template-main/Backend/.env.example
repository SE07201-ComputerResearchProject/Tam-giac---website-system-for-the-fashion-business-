# Backend Tam-Giac - Copy thành .env và fill thông tin thật

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-1234567890

# SQL Server Database (quan trọng nhất!)
DB_HOST=localhost
DB_PORT

# reCAPTCHA v2 (Google public test keys) - safe for local testing only
# Site key (public): used in client pages
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Secret key (server): used to verify tokens with Google's API
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Enable reCAPTCHA checks when true
RECAPTCHA_ENABLED=true
